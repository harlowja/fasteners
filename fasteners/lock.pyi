import logging
import threading
from types import TracebackType
from typing import Callable, ContextManager, Deque, Dict, Hashable, Optional, Type, TypeVar, Union, overload
from typing_extensions import ParamSpec, Protocol

_P = ParamSpec("_P")
_R = TypeVar("_R")

class _Condition(Protocol):
    def __enter__(self) -> _Condition: ...
    def __exit__(
        self,
        exc_type: Optional[Type[BaseException]],
        exc_value: Optional[BaseException],
        exc_tb: Optional[TracebackType],
    ) -> Optional[bool]: ...
    def wait(self, timeout: Optional[float] = ...) -> bool: ...
    def notify_all(self) -> None: ...

class _Lock(Protocol):
    def acquire(self, blocking: bool = ...) -> bool: ...
    def release(self) -> None: ...

class ReaderWriterLock:
    WRITER: str
    READER: str
    _writer: Optional[Hashable]
    _writer_entries: int
    _pending_writers: Deque[Hashable]
    _readers: Dict[Hashable, int]
    _cond: _Condition
    _current_thread: Callable[[], Hashable]

    def __init__(
        self,
        condition_cls: Union[Type[threading.Condition], Callable[[], _Condition]] = ...,
        current_thread_functor: Callable[[], Hashable] = ...,
    ) -> None: ...
    @property
    def has_pending_writers(self) -> bool: ...
    def is_writer(self, check_pending: bool = ...) -> bool: ...
    def is_reader(self) -> bool: ...
    @property
    def owner(self) -> Optional[str]: ...
    def acquire_read_lock(self) -> None: ...
    def release_read_lock(self) -> None: ...
    def _acquire_read_lock(self, me: Hashable) -> None: ...
    def _release_read_lock(
        self, me: Hashable, raise_on_not_owned: bool = ...
    ) -> None: ...
    def read_lock(self) -> ContextManager[ReaderWriterLock]: ...
    def _acquire_write_lock(self, me: Hashable) -> None: ...
    def _release_write_lock(
        self, me: Hashable, raise_on_not_owned: bool = ...
    ) -> None: ...
    def acquire_write_lock(self) -> None: ...
    def release_write_lock(self) -> None: ...
    def write_lock(self) -> ContextManager[ReaderWriterLock]: ...

@overload
def locked(__func: Callable[_P, _R]) -> Callable[_P, _R]: ...
@overload
def locked(
    *, lock: str = ..., logger: Optional[logging.Logger] = ...
) -> Callable[[Callable[_P, _R]], Callable[_P, _R]]: ...

@overload
def read_locked(__func: Callable[_P, _R]) -> Callable[_P, _R]: ...
@overload
def read_locked(
    *, lock: str = ...
) -> Callable[[Callable[_P, _R]], Callable[_P, _R]]: ...

@overload
def write_locked(__func: Callable[_P, _R]) -> Callable[_P, _R]: ...
@overload
def write_locked(
    *, lock: str = ...
) -> Callable[[Callable[_P, _R]], Callable[_P, _R]]: ...

def try_lock(lock: _Lock) -> ContextManager[bool]: ...
